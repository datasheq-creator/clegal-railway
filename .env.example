# ─── Required ────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; 3000 is the local default.
PORT=3000

# SendGrid API key with "Mail Send" permission.
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Must be a verified Single Sender or belong to an authenticated domain in SendGrid.
# (Alias: SENDGRID_FROM_EMAIL — the name used by the DATASHEQ site.)
SENDGRID_SENDER_EMAIL=verified_sender@domain.com
# Company inbox that receives every new lead. Comma-separate several addresses.
# (Alias: CONTACT_TO_EMAIL — the name used by the DATASHEQ site.)
ADMIN_EMAIL=internal_destination@domain.com

# ─── Optional ────────────────────────────────────────────────────────────────
# Display name used in the "From" header (default: C-Legal).
SENDGRID_SENDER_NAME=C-Legal

# Public URL of the deployed site (canonical URLs, OG tags, logo in emails).
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# Links that only render when set.
NEXT_PUBLIC_LOGIN_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_DATASHEQ_URL=
