# ─────────────────────────────────────────────────────────────
#  Environment variables — add them in Railway (Service → Variables).
#  SAME variables as the DATASHEQ site. Links (login, app stores, Datasheq site)
#  are not variables: they live in lib/site.ts.
#  For local development, copy this file to ".env" (or leave SendGrid empty: emails
#  are then saved to ./.mail-outbox instead of being sent).
# ─────────────────────────────────────────────────────────────

# SendGrid API key with "Mail Send" permission (SendGrid → Settings → API Keys)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must be VERIFIED in SendGrid (Single Sender or authenticated domain)
SENDGRID_FROM_EMAIL=no-reply@datasheq.com
SENDGRID_FROM_NAME=C-Legal

# Company inbox: where every contact-form request is delivered (comma-separate several addresses)
CONTACT_TO_EMAIL=contacto@datasheq.com

# Optional: "Reply-To" on the email the client receives (default: first CONTACT_TO_EMAIL address)
CLIENT_REPLY_TO=

# Optional: public URL of the site, no trailing slash. Used in emails (logo, links), QR codes and SEO tags.
# On Railway, if empty, the service's public domain (RAILWAY_PUBLIC_DOMAIN) is used automatically.
PUBLIC_BASE_URL=

# Optional: "true" = SendGrid validates the request but does NOT deliver it (testing)
SENDGRID_SANDBOX=false

# Optional: "eu" only if your SendGrid account/subuser uses EU data residency
SENDGRID_DATA_RESIDENCY=

# Optional: successful submissions allowed per IP every 10 minutes (default 5)
CONTACT_RATE_LIMIT=5

# Railway sets PORT automatically. Locally the app uses 3000.
# PORT=3000
